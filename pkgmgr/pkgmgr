#!/usr/bin/env bash

USE_COLOR=0

if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
  if command -v tput >/dev/null 2>&1; then
    ncolors=$(tput colors)
    if [[ -n "$ncolors" ]] && [[ "$ncolors" -ge 8 ]]; then
      USE_COLOR=1
    fi
  fi
fi

if ((USE_COLOR)); then
  YELLOW="$(printf '\033[33m')"
  BLUE="$(printf '\033[34m')"
  GREEN="$(printf '\033[32m')"
  RED="$(printf '\033[31m')"
  BOLD="$(printf '\033[1m')"
  RESET="$(printf '\033[0m')"
else
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  BOLD=''
  RESET=''
fi

printMsg() {
  printf '\n%s%s>>> %s%s\n' "$BLUE" "$BOLD" "$1" "$RESET"
}

printDone() {
  printf '\n%s%s✔ %s%s\n' "$GREEN" "$BOLD" "$1" "$RESET"
}

printWarn() {
  printf '\n%s%s! %s%s\n' "$YELLOW" "$BOLD" "$1" "$RESET"
}

printError() {
  printf '\n%s%s✘ %s%s\n' "$RED" "$BOLD" "$1" "$RESET"
}

printEnd() {
  printf '\n%s%s::%s::%s\n' "$GREEN" "$BOLD" "$1" "$RESET"
}

preCheck() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    if command -v alacritty >/dev/null; then
      exec alacritty -e bash "$0" "$@"
    elif command -v kitty >/dev/null; then
      exec kitty -e bash "$0" "$@"
    elif command -v konsole >/dev/null; then
      exec konsole -e bash "$0" "$@"
    elif command -v gnome-terminal >/dev/null; then
      exec gnome-terminal -- bash "$0" "$@"
    else
      echo "No terminal emulator found"
      exit 1
    fi
  fi

  if ! command -v pacman >/dev/null; then
    printWarn "Run only on systems with pacman as the package manager.\nIf you somehow managed to delete the \"pacman\" package then IDK.\n"
    printError "Press any key to EXIT"
    read -r
    exit 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    printError "\"fzf\" is required."
    exit 1
  fi
}

helptext() {
  printf '%sA package manager for Arch Based Systems using pacman, AUR and Flatpak repos. Supports "yay" and "paru" AUR helpers.%s\n' "$YELLOW" "$RESET"
  echo
  printf '    %s--help | -h%s       :         Shows the help menu (This menu)\n' "$BLUE" "$RESET"
  printf '    %s--update%s          :         Updates the system\n' "$BLUE" "$RESET"
  printf '    %s--updatecount%s     :         Shows the number of available updates\n' "$BLUE" "$RESET"
}

aurSetup() {
  forceAurHelperCacheReset="$1"
  aurDetect() {
    aurHelperCacheFile="${XDG_CACHE_HOME:-$HOME/.cache}/aurHelper"
    mkdir -p "$(dirname "$aurHelperCacheFile")"
    if [[ $forceAurHelperCacheReset != --forcereset ]]; then
      if [ -f "$aurHelperCacheFile" ]; then
        savedAURHelper=$(<"$aurHelperCacheFile")
        if command -v "$savedAURHelper" >/dev/null 2>&1; then
          aurHelper="$savedAURHelper"
          return
        fi
      fi
    fi

    aurHelpers=()
    command -v yay >/dev/null 2>&1 && aurHelpers+=("yay")
    command -v paru >/dev/null 2>&1 && aurHelpers+=("paru")

    if [ ${#aurHelpers[@]} -eq 0 ]; then
      aurHelper="None"
      echo "$aurHelper" >"$aurHelperCacheFile"
    elif [ ${#aurHelpers[@]} -eq 1 ]; then
      aurHelper="${aurHelpers[0]}"
      echo "$aurHelper" >"$aurHelperCacheFile"
    else
      aurHelpers+=("None")
      aurHelper=$(printf "%s\n" "${aurHelpers[@]}" |
        fzf --prompt="Select AUR Helper: " \
          --header="Choose which AUR helper to use. If you dont have a AUR helper choose \"None\"" \
          --preview-window=wrap \
          --preview '
                    echo "Hovered Option:";
                    echo {}
            ')
      [ -z "$aurHelper" ] && echo "No selection made. Exiting." && exit 1
      echo "$aurHelper" >"$aurHelperCacheFile"
    fi
  }

  aurArgs() {
    if [[ "$aurHelper" != "None" ]]; then
      if [[ "$aurHelper" = "yay" ]]; then
        aurHelperArgs=(--devel
          --needed
          --answerupgrade None
          --answerclean All
          --answerdiff None
          --noremovemake
          --redownload
          --rebuild
          --cleanafter
          --sudoloop
          --noconfirm
          --mflags
          --noconfirm)
        aurDevelDataGenArgs=(-Y --gendb)
        cleanPkgArgs=(-Scc)
      elif [[ "$aurHelper" = "paru" ]]; then
        aurHelperArgs=()
        aurDevelDataGenArgs=(--gendb)
        cleanPkgArgs=(-Sccd)
      fi
    fi
  }
  aurDetect
  aurArgs
}

inhibitSleepStart() {
  if command -v systemd-inhibit >/dev/null 2>&1; then
    printWarn "Inhibiting Sleep using \"systemd-inhibit\"."
    # shellcheck disable=SC2016
    setsid sh -c '
            exec systemd-inhibit \
                --what=idle:sleep \
                --who="$1" \
                --why="$2" \
                sleep infinity
        ' _ "$1" "$2" >/dev/null 2>&1 &

    inhibitSleepPid=$!
  else
    printWarn "\"systemd-inhibit\" command not found. Unable to Inhibit Sleep."
    inhibitSleepPid=
  fi
}

inhibitSleepStop() {
  if [[ -n "$inhibitSleepPid" ]]; then
    kill "$inhibitSleepPid" 2>/dev/null
    wait "$inhibitSleepPid" 2>/dev/null
    inhibitSleepPid=
  fi
}

continuePromptAnyKey() {
    printEnd "Press any key to Continue"
    trap 'inhibitSleepStop; trap - INT; return 130' INT
    read -n1 -r
    trap - INT
}

copyPkgNames() {
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s\n' "$@" | wl-copy 2>/dev/null &&
            printDone "Copied Package Names to clipboard"
        printf '%s\n' "$@"
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s\n' "$@" | xclip -selection clipboard 2>/dev/null &&
            printDone "Copied Package Names to clipboard"
        printf '%s\n' "$@"
    else
        printError "\"wl-copy\" or \"xclip\" not found. Install either one to copy the Package Names.\n\nSelected Packages:"
        printf '%s\n' "$@"
    fi
}

installPacmanPkgs() {
  printMsg "Installing Packages $*..."
  trap 'trap - INT; return 130' INT
  sudo pacman -S --noconfirm "$@"
  local status=$?
  trap - INT
  return "$status"
}

installAURPkgs() {
  printMsg "Installing Packages $*..."
  trap 'trap - INT; return 130' INT
  "$aurHelper" "${aurHelperArgs[@]}" -S "$@"
  local status=$?
  trap - INT
  return "$status"
}

installFlatpakPkgs() {
  local entry app repo branch arch
  local status

  for entry in "$@"; do
    read -r app repo branch arch <<<"$entry"

    printMsg "Installing Package $app/$arch/$branch from $repo..."

    trap 'trap - INT; return 130' INT

    case "$selectedflatpakInstallType" in
    System)
      flatpak --system install --assumeyes \
        "$repo" "$app/$arch/$branch"
      ;;

    User)
      flatpak --user install --assumeyes \
        "$repo" "$app/$arch/$branch"
      ;;
    esac

    status=$?
    trap - INT

    [[ $status -ne 0 ]] && return "$status"
  done

  return 0
}

uninstallPacmanPkgs() {
  printMsg "Uninstalling Packages $*..."
  trap 'trap - INT; return 130' INT
  sudo pacman -Rns --noconfirm "$@"
  local status=$?
  trap - INT
  return "$status"
}

uninstallAURPkgs() {
  printMsg "Uninstalling Packages $*..."
  trap 'trap - INT; return 130' INT
  "$aurHelper" -Rns --noconfirm "$@"
  local status=$?
  trap - INT
  return "$status"
}

uninstallFlatpakPkgs() {
  flatpakUninstallSuccessPkgNames=()
  flatpakUninstallFailedPkgNames=()
  flatpakUninstallFailedAppDataPkgNames=()

  local flatpakUninstallPkgName
  local flatpakUninstallStatus
  local flatpakDataDir
  local flatpakAppDataStatus
  local ans
  local flatpakUninstallProcessedAppDataPkgNames=()
  local flatpakUninstallProcessedAppDataPkgName

  trap '
    flatpakUninstallFailedPkgNames=("$@")

    for flatpakUninstallSuccessPkgName in "${flatpakUninstallSuccessPkgNames[@]}"; do
      flatpakUninstallFailedPkgNames=(
        "${flatpakUninstallFailedPkgNames[@]/$flatpakUninstallSuccessPkgName}"
      )
    done

    trap - INT
    return 130
  ' INT

  for flatpakUninstallPkgName in "$@"; do
    [[ -z "$flatpakUninstallPkgName" ]] && continue

    printMsg "Uninstalling Package $flatpakUninstallPkgName..."

    flatpak uninstall --assumeyes "$flatpakUninstallPkgName"
    flatpakUninstallStatus=$?

    if [[ $flatpakUninstallStatus -eq 0 ]]; then
      printDone "$flatpakUninstallPkgName uninstalled successfully"
      flatpakUninstallSuccessPkgNames+=("$flatpakUninstallPkgName")
    else
      printError "Failed to uninstall $flatpakUninstallPkgName"
      flatpakUninstallFailedPkgNames+=("$flatpakUninstallPkgName")
    fi
  done

  trap '
    flatpakUninstallFailedAppDataPkgNames=(
      "${flatpakUninstallSuccessPkgNames[@]}"
    )

    for flatpakUninstallProcessedAppDataPkgName in "${flatpakUninstallProcessedAppDataPkgNames[@]}"; do
      flatpakUninstallFailedAppDataPkgNames=(
        "${flatpakUninstallFailedAppDataPkgNames[@]/$flatpakUninstallProcessedAppDataPkgName}"
      )
    done

    trap - INT
    return 130
  ' INT

  for flatpakUninstallSuccessPkgName in "${flatpakUninstallSuccessPkgNames[@]}"; do
    flatpakDataDir="$HOME/.var/app/$flatpakUninstallSuccessPkgName"

    if [[ -d "$flatpakDataDir" ]]; then
      printWarn "App data found for $flatpakUninstallSuccessPkgName"
      printMsg "Do you want to remove app data for '$flatpakUninstallSuccessPkgName'? (y/N): "

      read -r ans </dev/tty

      if [[ "$ans" =~ ^[Yy]$ ]]; then
        echo "Deleting app data: $flatpakDataDir"

        rm -rfv -- "$flatpakDataDir"
        flatpakAppDataStatus=$?

        if [[ $flatpakAppDataStatus -eq 0 ]]; then
          printDone "App data removed for $flatpakUninstallSuccessPkgName"
        else
          printError "Failed to remove app data for $flatpakUninstallSuccessPkgName"
          flatpakUninstallFailedAppDataPkgNames+=(
            "$flatpakUninstallSuccessPkgName"
          )
        fi
      else
        printMsg "App data retained for $flatpakUninstallSuccessPkgName"
      fi
    else
      printWarn "No app data found for $flatpakUninstallSuccessPkgName"
    fi

    flatpakUninstallProcessedAppDataPkgNames+=(
      "$flatpakUninstallSuccessPkgName"
    )
  done

  trap - INT

  if ((${#flatpakUninstallFailedPkgNames[@]} || \
    ${#flatpakUninstallFailedAppDataPkgNames[@]})); then
    return 1
  fi

  return 0
}

whichPkgType() {
  case "$aurHelper" in
  "None")
    pkgTypeChoices="Pacman"
    ;;
  *)
    pkgTypeChoices="Pacman\nAUR"
    ;;
  esac

  command -v flatpak >/dev/null && pkgTypeChoices="${pkgTypeChoices}\nFlatpak"
  pkgTypeChoices="${pkgTypeChoices}\nBack"

  selectedPkgType=$(printf "%b" "$pkgTypeChoices" |
    fzf --prompt="Search: " \
      --header="Select package type: " \
      --preview-window=wrap \
      --preview '
        if [[ {} = "Back" ]]; then
          echo "↩ Return to previous menu"
        else
          echo "Hovered Option:"
          echo {}
        fi
      ')
}

listFlatpakInstallType() {
  while true; do
    flatpakInstallTypeChoices="System\nUser\nBack"

    selectedflatpakInstallType=$(printf "%b" "$flatpakInstallTypeChoices" |
      fzf --prompt="Search: " \
        --header="Select Flatpak Install type: " \
        --preview-window=wrap \
        --preview '
          if [[ {} = "Back" ]]; then
            echo "↩ Return to previous menu"
          else
            echo "Hovered Option:"
            echo {}
          fi
        ')

    [ -z "$selectedflatpakInstallType" ] && return 1

    case "$selectedflatpakInstallType" in
    Back)
      return 1
      ;;
    System | User)
      return 0
      ;;
    esac
  done
}

fzfSelectPkgs() {
  local listCmd="$1"
  local previewCmd="$2"

  selectedPkgNames=$({
    printf "Back\n"
    eval "$listCmd" 2>/dev/null
  } |
    fzf --multi \
      --prompt="Search Packages: " \
      --header="Use TAB to select, ENTER to confirm." \
      --preview-window=wrap \
      --preview '
        if [[ {} = "Back" ]]; then
          echo "↩ Return to previous menu"
        else
          echo "Selected Packages:"
          echo {+} | tr " " "\n"
          echo
          echo "Hovered Packages:"
          echo {} | tr " " "\n"
          echo
          '"$previewCmd"'
        fi
      ')

  [[ -z "$selectedPkgNames" ]] && return 1
  [[ "$selectedPkgNames" == "Back" ]] && return 1

  return 0
}

listRemotePacmanPkgs() {
  local listRemotePkgCmd="pacman -Slq"

  local fzfPreviewRemotePkgs='
    if pacman -Qin {1} &>/dev/null; then
      echo "*****Installed*****"
      echo
      pacman -Qin {1}
    else
      pacman -Si {1}
    fi
  '

  fzfSelectPkgs "$listRemotePkgCmd" "$fzfPreviewRemotePkgs"
}

listRemoteAURPkgs() {
  local listRemotePkgCmd="$aurHelper -Slqa"

  local fzfPreviewRemotePkgs='
    if '"$aurHelper"' -Qim {1} &>/dev/null; then
      echo "*****Installed*****"
      echo
      '"$aurHelper"' -Qim {1} || pacman -Qim {1}
    else
      '"$aurHelper"' -Si {1}
    fi
  '

  fzfSelectPkgs "$listRemotePkgCmd" "$fzfPreviewRemotePkgs"
}

listRemoteFlatpakPkgs() {
  listFlatpakInstallType || return 1

  local listRemotePkgCmd

  local fzfPreviewRemotePkgs='
    if flatpak info --system {1} &>/dev/null || flatpak info --user {1} &>/dev/null; then
      echo "*****Installed*****"
      echo
      flatpak info {1}
    else
      flatpak remote-info --system {2} {1}/{4}/{3} 2>/dev/null ||
        flatpak remote-info --user {2} {1}/{4}/{3} 2>/dev/null
    fi
  '

  case "$selectedflatpakInstallType" in
  System)
    listRemotePkgCmd='flatpak remote-ls --system --app --columns=application,origin,branch,arch'
    ;;

  User)
    listRemotePkgCmd='flatpak remote-ls --user --app --columns=application,origin,branch,arch'
    ;;
  esac

  fzfSelectPkgs "$listRemotePkgCmd" "$fzfPreviewRemotePkgs"
}

listInstalledPacmanPkgs() {
  local listInstalledPkgCmd="pacman -Qqn"
  local fzfPreviewInstalledPkgs='pacman -Qin {1}'

  fzfSelectPkgs "$listInstalledPkgCmd" "$fzfPreviewInstalledPkgs"
}

listInstalledAURPkgs() {
  local listInstalledPkgCmd="$aurHelper -Qqm"
  local fzfPreviewInstalledPkgs="$aurHelper -Qim {1} || pacman -Qim {1}"

  fzfSelectPkgs "$listInstalledPkgCmd" "$fzfPreviewInstalledPkgs"
}

listInstalledFlatpakPkgs() {
  listFlatpakInstallType || return 1

  local listInstalledPkgCmd
  local fzfPreviewInstalledPkgs='flatpak info {1}'

  case "$selectedflatpakInstallType" in
  System)
    listInstalledPkgCmd="flatpak list --system --columns=application --app"
    ;;

  User)
    listInstalledPkgCmd="flatpak --user list --columns=application --app"
    ;;
  esac

  fzfSelectPkgs "$listInstalledPkgCmd" "$fzfPreviewInstalledPkgs"
}

listOrphanPkgs() {
  local listCmd="pacman -Qdtq"
  local previewCmd="pacman -Qi {1}"

  fzfSelectPkgs "$listCmd" "$previewCmd" || return

  selectedPkgType="Pacman"
}

listRemotePkgs() {
    whichPkgType

    [ -z "$selectedPkgType" ] && return 1

    case "$selectedPkgType" in
    Pacman)
      listRemotePacmanPkgs
      ;;

    AUR)
      listRemoteAURPkgs
      ;;

    Flatpak)
      listRemoteFlatpakPkgs
      ;;

    Back)
      return 1
      ;;
    esac
}

listInstalledPkgs() {
    whichPkgType

    [ -z "$selectedPkgType" ] && return 1

    case "$selectedPkgType" in
    Pacman)
      listInstalledPacmanPkgs
      ;;

    AUR)
      listInstalledAURPkgs
      ;;

    Flatpak)
      listInstalledFlatpakPkgs
      ;;

    Back)
      return 1
      ;;
    esac
}

installStatusHandler() {
  local installStatus=$1

  if [[ $installStatus -eq 0 ]]; then
    printDone "Successfully Installed Packages"
  elif [[ $installStatus -eq 130 ]]; then
    printError "Package Install interrupted"
  else
    printError "Failed to Install Packages"
  fi
}

uninstallStatusHandler() {
  local uninstallStatus=$1

  if [[ $uninstallStatus -eq 0 ]]; then
    printDone "Successfully Uninstalled Packages"

  elif [[ $uninstallStatus -eq 130 ]]; then
    if ((${#flatpakUninstallFailedPkgNames[@]})); then
      printError "Package Uninstall interrupted.. Failed to Uninstall ${flatpakUninstallFailedPkgNames[*]}"
    elif ((${#flatpakUninstallFailedAppDataPkgNames[@]})); then
      printError "Package Uninstall interrupted.. Failed to Delete App Data for ${flatpakUninstallFailedAppDataPkgNames[*]}"
    else
      printError "Package Uninstall interrupted"
    fi

  else
    if ((${#flatpakUninstallFailedPkgNames[@]})); then
      printError "Failed to Uninstall ${flatpakUninstallFailedPkgNames[*]}"
    fi

    if ((${#flatpakUninstallFailedAppDataPkgNames[@]})); then
      printError "Failed to Delete App Data for ${flatpakUninstallFailedAppDataPkgNames[*]}"
    fi

    if ((${#flatpakUninstallFailedPkgNames[@]} == 0 && \
      ${#flatpakUninstallFailedAppDataPkgNames[@]} == 0)); then
      printError "Failed to Uninstall Packages"
    fi
  fi
}

installListedPkgs() {
  local installStatus

  case "$selectedPkgType" in
  Pacman)
    installPacmanPkgs "$@"
    installStatus=$?
    ;;

  AUR)
    installAURPkgs "$@"
    installStatus=$?
    ;;

  Flatpak)
    installFlatpakPkgs "$@"
    installStatus=$?
    ;;
  esac

  installStatusHandler "$installStatus"
}

uninstallListedPkgs() {
  local uninstallStatus

  case "$selectedPkgType" in
  Pacman)
    uninstallPacmanPkgs "$@"
    uninstallStatus=$?
    ;;

  AUR)
    uninstallAURPkgs "$@"
    uninstallStatus=$?
    ;;

  Flatpak)
    uninstallFlatpakPkgs "$@"
    uninstallStatus=$?
    ;;
  esac

  uninstallStatusHandler "$uninstallStatus"
}

installPkgs() {
  local listFunc="$1"
  local installPkgNames

  "$listFunc" || return

  mapfile -t installPkgNames <<<"$selectedPkgNames"

  inhibitSleepStart "$0" "Prevent shutdown/sleep during package Install"
  installListedPkgs "${installPkgNames[@]}"
  continuePromptAnyKey
  inhibitSleepStop
}

uninstallPkgs() {
  local listFunc="$1"
  local uninstallPkgNames

  "$listFunc" || return

  mapfile -t uninstallPkgNames <<<"$selectedPkgNames"

  inhibitSleepStart "$0" "Prevent shutdown/sleep during package Uninstall"
  uninstallListedPkgs "${uninstallPkgNames[@]}"
  continuePromptAnyKey
  inhibitSleepStop
}

cleanup() {
  local pid=${1:-$$}
  local children
  children=$(pgrep -P "$pid" 2>/dev/null)
  for child in $children; do
    cleanup "$child"
  done
  # Kill the process itself, but never the script's main PID
  if [[ "$pid" != "$$" ]]; then
    kill -9 "$pid" 2>/dev/null
  fi
}

checkUpdateList() {
  trap 'cleanup; echo "Ctrl+C pressed, update checks stopped."; return 130' INT

  local updatePkgList
  updatePkgList=$(mktemp -u)
  mkfifo "$updatePkgList"

  if [[ "${1}" == "fzf" ]]; then
    echo "Back" >>"$updatePkgList" &
  fi

  { checkupdates 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' >>"$updatePkgList"; } &

  if [ "$aurHelper" != "None" ]; then
    { "$aurHelper" -Qua --devel 2>/dev/null | grep -vF "devel check for package failed" >>"$updatePkgList"; } &
  fi

  if command -v flatpak >/dev/null; then
    { flatpak remote-ls --updates --columns=application,version 2>/dev/null | grep -v "Application ID" >>"$updatePkgList"; } &
  fi

  "$@" <"$updatePkgList"
  local cmdStatus=$?
  cleanup
  rm -f "$updatePkgList"
  return $cmdStatus
}

pkgUpdateCount() {
  checkUpdateList wc -l
}

listUpdatePkgs() {
  while true; do
    case "$aurHelper" in
    "None")
      command -v flatpak >/dev/null && fzfPreviewUpdateListInfo="pacman -Si {1} || flatpak info {1}" || fzfPreviewUpdateListInfo="pacman -Si {1}"
      ;;
    *)
      command -v flatpak >/dev/null && fzfPreviewUpdateListInfo="$aurHelper -Si {1} || flatpak info {1}" || fzfPreviewUpdateListInfo="$aurHelper -Si {1}"
      ;;
    esac

    local selectedPkgNames
    selectedPkgNames=$(checkUpdateList fzf --multi \
      --prompt="Search Packages: " \
      --header="Use TAB to select, ENTER to Update All Packages." \
      --preview-window=wrap \
      --preview '
            if [[ {} = "Back" ]]; then
                echo "↩ Return to previous menu"
            else
                '"$fzfPreviewUpdateListInfo"'
            fi
        ')

    [ -z "$selectedPkgNames" ] && return

    case "$selectedPkgNames" in
    "Back")
      return
      ;;
    *)
      updatePkgs
      return
      ;;
    esac
  done
}

updateStatusHandler() {
  local border=false
  local summary=false

  for arg in "$@"; do
    case "$arg" in
    --border)
      border=true
      ;;
    --summary)
      summary=true
      border=true
      ;;
    esac
  done

  if $summary; then
    set -- --arch --aur --flatpak
  fi

  if $border; then
    echo
    printEnd "UPGRADE SUMMARY"
    printWarn "------------------------------------------------------------------------- !"
  fi

  for arg in "$@"; do
    case "$arg" in
    --arch)
      if [[ $pacmanUpdateStatus -eq 0 ]]; then
        printDone "Arch repo packages updated"
      elif [[ $pacmanUpdateStatus -eq 130 ]]; then
        printError "Arch repo update interrupted"
      else
        printError "Failed to update Arch repo packages"
      fi
      ;;

    --aur)
      if [[ "$aurHelper" != "None" ]]; then
        if [[ $AURUpdateStatus -eq 0 ]]; then
          printDone "AUR packages updated"
        elif [[ $AURUpdateStatus -eq 130 ]]; then
          printError "AUR update interrupted"
        else
          printError "Failed to update AUR packages"
        fi
      fi
      ;;

    --flatpak)
      if command -v flatpak >/dev/null; then
        if [[ $flatpakUpdateStatus -eq 0 ]]; then
          printDone "Flatpak packages updated"
        elif [[ $flatpakUpdateStatus -eq 130 ]]; then
          printError "Flatpak update interrupted"
        else
          printError "Failed to update Flatpak packages"
        fi
      fi
      ;;
    esac
  done

  if $border; then
    printWarn "------------------------------------------------------------------------- !"
  fi
}

updateArchPkgs() {
  printMsg "Updating Arch repo packages with \"sudo pacman -Syu\"..."
  trap 'pacmanUpdateStatus=130' INT
  sudo pacman -Syu --noconfirm
  pacmanUpdateStatus=$?
  trap - INT
}

updateAURPkgs() {
  printMsg "Updating AUR packages with \"$aurHelper ${aurHelperArgs[*]} -Syua\"..."
  trap 'AURUpdateStatus=130' INT
  "$aurHelper" "${aurHelperArgs[@]}" -Syua
  AURUpdateStatus=$?
  trap - INT
}

updateFlatpakPkgs() {
  printMsg "Updating Flatpak packages with \"flatpak update --assumeyes\"..."
  trap 'flatpakUpdateStatus=130' INT
  flatpak update --assumeyes
  flatpakUpdateStatus=$?
  trap - INT
}

updateAllPkgs() {
  printWarn "Started Full System Upgrade..."
  updateArchPkgs
  if [[ "$aurHelper" != "None" ]]; then
    updateAURPkgs
  fi
  if command -v flatpak >/dev/null; then
    updateFlatpakPkgs
  fi
}

listUpdateTypes() {
  while true; do
    case "$aurHelper" in
    "None")
      updateTypeChoices="Pacman"
      ;;
    *)
      updateTypeChoices="Pacman\nAUR"
      ;;
    esac

    command -v flatpak >/dev/null && updateTypeChoices="${updateTypeChoices}\nFlatpak"
    updateTypeChoices="${updateTypeChoices}\nFull System Upgrade\nBack"

    selectedUpdateType=$(printf "%b" "$updateTypeChoices" |
      fzf --prompt="Search: " \
        --header="Select package type: " \
        --preview-window=wrap \
        --preview '
                    if [[ {} = "Back" ]]; then
                        echo "↩ Return to previous menu"
                    else
                        echo "Hovered Option:";
                        echo {}
                    fi
            ')
    [ -z "$selectedUpdateType" ] && return
    case "$selectedUpdateType" in
    "Back") return ;;
    "Pacman")
      inhibitSleepStart "$0" "Prevent shutdown/sleep during system upgrade"
      updateArchPkgs
      updateStatusHandler --arch
      unset pacmanUpdateStatus
      continuePromptAnyKey
      inhibitSleepStop
      ;;
    "AUR")
      inhibitSleepStart "$0" "Prevent shutdown/sleep during system upgrade"
      updateAURPkgs
      updateStatusHandler --aur
      unset AURUpdateStatus
      continuePromptAnyKey
      inhibitSleepStop
      ;;
    "Flatpak")
      inhibitSleepStart "$0" "Prevent shutdown/sleep during system upgrade"
      updateFlatpakPkgs
      updateStatusHandler --flatpak
      unset flatpakUpdateStatus
      continuePromptAnyKey
      inhibitSleepStop
      ;;
    "Full System Upgrade")
      inhibitSleepStart "$0" "Prevent shutdown/sleep during system upgrade"
      updateAllPkgs
      updateStatusHandler --summary
      unset pacmanUpdateStatus AURUpdateStatus flatpakUpdateStatus
      continuePromptAnyKey
      inhibitSleepStop
      ;;
    esac
  done
}

generateAURDevelData() {
  printMsg "Generating data for Devel Packages eg:- \"-git\" Packages"
  trap 'echo "Ctrl+C pressed; trap - INT; continuePromptAnyKey; return 130"' INT
  "$aurHelper" "${aurDevelDataGenArgs[@]}"
  trap - INT
  continuePromptAnyKey
}

cleanPkgCache() {
  printMsg "Cleaning Package Cache"
  trap 'echo Ctrl+C pressed; trap - INT; continuePromptAnyKey; return 130' INT
  sudo rm -rfv -- /var/cache/pacman/pkg/download-*
  if [[ "$aurHelper" = "None" ]]; then
    yes | sudo pacman -Scc
  else
    yes | "$aurHelper" "${cleanPkgArgs[@]}"
  fi
  if command -v flatpak >/dev/null; then
    flatpak uninstall --unused
  fi
  trap - INT
  continuePromptAnyKey
}

checkMissingPkgFromGroup() {
  while true; do
    selectedPkgGroup=$({
      printf "Back\n"
      pacman -Qg | awk '!seen[$1]++ { print $1 }'
    } |
      fzf \
        --prompt="Search Package Group: " \
        --header="Press ENTER View Not Installed Packages From the Selected Group." \
        --preview-window=wrap \
        --preview '
          if [[ {} = "Back" ]]; then
              echo "↩ Return to previous menu"
          else
              echo "Hovered Package Group:";
              echo {} | tr " " "\n";
          fi
    ')
    [ -z "$selectedPkgGroup" ] && return
    case "$selectedPkgGroup" in
    "Back") return ;;
    *)
      local selectedPkgNames
      selectedPkgNames=$({
        printf "Back\n"
        comm -23 <(pacman -Sg "$selectedPkgGroup" | awk '{print $2}' | sort) <(pacman -Qq | sort)
      } |
        fzf --multi \
          --prompt="Search Packages: " \
          --header="Use TAB to select, ENTER to Install." \
          --preview-window=wrap \
          --preview '
          if [[ {} = "Back" ]]; then
              echo "↩ Return to previous menu"
          else
              echo "Selected Packages:";
              echo {+} | tr " " "\n";
              echo;
              echo "Hovered Packages:";
              echo {} | tr " " "\n";
              echo;
              pacman -Si {1}
          fi
  ')
      [ -z "$selectedPkgNames" ] && continue
      case "$selectedPkgNames" in
      "Back") continue ;;
      *)
        mapfile -t missingPkgNames <<<"$selectedPkgNames"
        inhibitSleepStart "$0" "Prevent shutdown/sleep during package Install"
        selectedPkgType="Pacman" && installListedPkgs "${missingPkgNames[@]}"
        continuePromptAnyKey
        inhibitSleepStop
        ;;
      esac
      ;;
    esac
  done
}

pkgMenu() {
  while true; do
    pkgManager=$(
      {
        printf "Install Packages\n"
        printf "Uninstall Packages\n"
        printf "Check Updates\n"
        printf "Update System\n"
        printf "Check Missing Package From Package Group\n"
        printf "List Orphan Packages\n"
        printf "Clean Package Cache\n"
        if [[ "$aurHelper" != "None" ]]; then
          printf "Generate devel Data For AUR Helpers\n"
        fi
        printf "Change AUR Helper\n"
        printf "Exit"
      } |
        fzf --prompt="Search: " \
          --header="Select Operation: " \
          --preview-window=wrap \
          --preview '
                printf '"'AUR Helper = %s\n'"' '"$aurHelper"'
                if [[ '"$aurHelper"' = "None" ]]; then
                  echo "\nPacman-only mode"
                fi
                echo;
                echo "Hovered Option:";
                echo {};
                echo;
                if [[ {} = "Exit" ]]; then
                  echo "↩ Exit the Manager"
                fi
        '
    )
    [ -z "$pkgManager" ] && return
    case "$pkgManager" in
    "Install Packages") installPkgs listRemotePkgs ;;
    "Uninstall Packages") uninstallPkgs listInstalledPkgs ;;
    "Check Updates") listUpdatePkgs ;;
    "Update System") listUpdateTypes ;;
    "Check Missing Package From Package Group") checkMissingPkgFromGroup ;;
    "List Orphan Packages") uninstallPkgs listOrphanPkgs ;;
    "Clean Package Cache") cleanPkgCache ;;
    "Generate Devel Data For AUR Helpers") generateAURDevelData ;;
    "Change AUR Helper") aurSetup --forcereset && continue ;;
    "Exit") break ;;
    esac
  done
}

case "$1" in
"--help" | "-h")
  preCheck "$@"
  helptext
  ;;
"--update")
  preCheck "$@"
  aurSetup
  listUpdateTypes
  ;;
"--listupdates")
  preCheck "$@"
  aurSetup
  listUpdatePkgs
  ;;
"--updatecount")
  aurSetup
  pkgUpdateCount
  ;;
*)
  preCheck "$@"
  aurSetup
  pkgMenu
  ;;
esac
