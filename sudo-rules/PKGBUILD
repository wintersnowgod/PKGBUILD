pkgname=sudo-rules
pkgver=1
pkgrel=1
pkgdesc="My custom sudo rules"
arch=('any')
source=("10-custom" "20-papirus-folders")
sha256sums=('d2afc77d359a0fdb21aa4f57a83d0502eaa4333d03a54b0522ea4b0a8f9d703d'
            'effaa2cc86d892196559fe10220e75c039fc95db0031e2b186ebb699d911315c')

package() {
  install -d -m750 "${pkgdir}/etc/sudoers.d"
  install -m440 "${srcdir}/10-custom" "${pkgdir}/etc/sudoers.d/10-custom"
  install -m440 "${srcdir}/20-papirus-folders" "${pkgdir}/etc/sudoers.d/20-papirus-folders"
}
