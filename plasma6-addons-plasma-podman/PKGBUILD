# Maintainer: wintersnowgod <git.xerox732@passinbox.com>
_pkgname=plasma-podman
pkgname=plasma6-applets-plasma-podman
pkgver=3.0
pkgrel=1
pkgdesc="Plasmoid for KDE Plasma to control docker containers"
arch=('any')
url="https://github.com/naraesk/plasma-podman"
provides=($pkgname)
conflicts=(${pkgname}-bin ${pkgname}-git)
license=('GPL-3.0-only')
depends=('plasma-workspace')
makedepends=('cmake' 'extra-cmake-modules')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('23b7b5eaa8604cf888115c1c228c900cd629fa73110800c0fb3c9ca9b64ef20e')

build() {
  cd "${_pkgname}-${pkgver}"
  mkdir build && cd build
  cmake -DCMAKE_INSTALL_PREFIX=$(qmake6 -query QT_INSTALL_PREFIX) -DCMAKE_BUILD_TYPE=Release -DKDE_INSTALL_LIBDIR=lib ../
  make
}

package() {
  cd "$srcdir/$_pkgname-$pkgver/build"
  DESTDIR=${pkgdir} make install
}
